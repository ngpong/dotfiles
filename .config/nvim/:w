local Options = {
  icon = vim.__icons.bookmark,
  icon_hl = { fg = vim.__color.bright_red },
  alis_hl = { fg = vim.__color.bright_red },
  line_hl = { bg = vim.__color.dark_red_hard },
}

local Bookmark = vim.__class.def(function(this)
  local buffer = require("string.buffer")

  local BOOKMARK_ICON_HL      = "BookmarkIcon"
  local BOOKMARK_ALIAS_HL     = "BookmarkAlias"
  local BOOKMARK_LINE_HL      = "BookmarkLine"
  local BOOKMARK_NAMESPACE_ID = vim.api.nvim_create_namespace("NGPONG-BOOKMARK-NAMESPACE")

  local bm_states, bm_persists = {}, {}

  local function get_extmark_lnum(bufnr, extmark_id)
    return vim.api.nvim_buf_get_extmark_by_id(bufnr, BOOKMARK_NAMESPACE_ID, extmark_id, {})[1] + 1
  end

  local function del_extmark(bufnr, extmark_id)
    return vim.api.nvim_buf_del_extmark(bufnr, BOOKMARK_NAMESPACE_ID, extmark_id)
  end

  local function get_extmarks(bufnr, lnum, opts, filter)
    local r_start, r_end
    if lnum then
      r_start = { lnum - 1, 0 }
      r_end   = { lnum - 1, -1 }
    else
      r_start = 0
      r_end   = -1
    end

    local extmarks = vim.api.nvim_buf_get_extmarks(
      bufnr,
      BOOKMARK_NAMESPACE_ID,
      r_start,
      r_end,
      opts or {}
    )
    if filter then
      vim.__tbl.remove_iter(extmarks, filter)
    end

    return extmarks
  end

  local function set_extmark(bufnr, lnum, col, opts)
    return vim.api.nvim_buf_set_extmark(
      bufnr,
      BOOKMARK_NAMESPACE_ID,
      lnum,
      col,
      opts
    )
  end

  local function concat_echo_str(lnum, alias)
    return alias and tostring(lnum) .. "\"" .. alias .. "\"" or tostring(lnum)
  end

  local function emit_state_changed()
    -- NOTE:
    -- 用于 trouble 在 preview 的状态下打开文件时，treesitter 会报错，目前
    -- 还未找到确切原因，所以暂时使用 schedule 来包装执行来规避这一问题
    vim.schedule(function()
      vim.__autocmd.exec("User", { pattern = "BookmarkCountChanged" })
      vim.__stl.redraw()
    end)
  end

  local function is_valid_bmid(bmid)
    if #bmid > 1 then
      return false
    end

    local code = string.byte(bmid)

    -- a~z and 1~9
    return (code >= 97 and code <= 122) or (code >= 49 and code <= 57)
  end

  function this:__init()
    vim.api.nvim_set_hl(0, BOOKMARK_ICON_HL, Options.icon_hl)
    vim.api.nvim_set_hl(0, BOOKMARK_ALIAS_HL, Options.alis_hl)
    vim.api.nvim_set_hl(0, BOOKMARK_LINE_HL, Options.line_hl)

    local bm_file = vim.__path.join(
      vim.__path.standard("data"),
      "bookmark",
      vim.__path.cwdsha1()
    )
    vim.__fs.makepath(vim.__path.dirname(bm_file))

    local serialize_data = vim.__fs.read(bm_file)
    if not vim.__util.isempty(serialize_data) then
      ---@diagnostic disable-next-line
      for path, v in pairs(buffer.decode(serialize_data) or {}) do
        if vim.__fs.readable(path) then
          bm_persists[path] = v
        end
      end
    end

    local function cvrt_state_2_persist(bufnr, state)
      local persist
      if state.modif then
        persist = { _ = {} }

        for bmid, bm in pairs(state._) do
          local extmark_id = bm.ex_ids[1]

          persist._[bmid] = {
            lnum = get_extmark_lnum(bufnr, extmark_id),
            alias = bm.alias
          }
        end
      end

      bm_states[bufnr] = nil

      return persist
    end
    vim.__autocmd.on("VimLeavePre", function()
      for bufnr, state in pairs(bm_states) do
        local persist = cvrt_state_2_persist(bufnr, state)
        if persist then
          bm_persists[vim.__buf.name(bufnr)] = persist
        end
      end
      vim.__fs.write(bm_file, buffer.encode(bm_persists))
    end)

    vim.__autocmd.on("BufDelete", function(args)
      local bufnr = args.buf

      local state = bm_states[bufnr]
      if not state then
        return
      end

      local persist = cvrt_state_2_persist(bufnr, state)
      if persist then
        bm_persists[vim.__buf.name(bufnr)] = persist
      end
    end)

    vim.__autocmd.on("BufRead", function(args)
      local bufnr = args.buf
      local path = args.match

      local bopts = vim.bo[bufnr]
      if bopts.readonly or not bopts.modifiable then
        return
      end

      local ft = vim.__buf.filetype(bufnr)
      if vim.__filter.contain_fts(ft) then
        return
      end

      local bt = vim.__buf.buftype(bufnr)
      if vim.__filter.contain_bts(bt) then
        return
      end

      -- 当文件改名时，则会沿用已存在的bufnr并执行一次 BufRead 事件
      if bm_states[bufnr] then
        return
      end
      bm_states[bufnr] = { _ = {} }

      local persist = bm_persists[path]
      if persist then
        bm_persists[path] = nil
      else
        return
      end

      vim.__autocmd.on("BufWinEnter", function()
        local maxline = vim.__buf.maxline(bufnr)

        local set_args = {}
        for bmid, bm in pairs(persist._) do
          if bm.lnum <= maxline then
            table.insert(set_args, { lnum = bm.lnum, bmid = bmid, alias = bm.alias })
          end
        end

        this:set(bufnr, set_args)
      end, { once = true, buffer = bufnr })
    end)
  end

  function this:get_extmarks(bufnr, lnum, opts)
    return get_extmarks(bufnr, lnum, opts)
  end

  local function set(bufnr, lnum, bmid, alias)
    local state = bm_states[bufnr]
    if not state then
      return
    end

    if not lnum or lnum <= 0 then
      return
    end

    if not bmid then
      return
    end

    if not is_valid_bmid(bmid) then
      vim.__echo.warn(string.format("invalid bookmark: %s not support", bmid))
      return
    end

    do
      local bm = state._[bmid]
      if bm then
        local oldlnum = get_extmark_lnum(bufnr, bm.ex_ids[1])

        for _, extmark_id in ipairs(bm.ex_ids) do
          del_extmark(bufnr, extmark_id)
        end

        vim.__echo.info(string.format(
          "replace bookmark: %s from line %s to %s",
          bmid,
          concat_echo_str(oldlnum, bm.alias),
          concat_echo_str(lnum, alias)
        ))

        state._[bmid] = nil
      end
    end

    -- bookmark sign
    local extmark_id0 = set_extmark(
      bufnr,
      lnum - 1, 0,
      {
        sign_text = Options.icon,
        sign_hl_group = BOOKMARK_ICON_HL,
        priority = 1,
        -- undo_restore = false,
        -- invalidate = true,
      }
    )

    -- bookmark full-line
    local extmark_id1 = set_extmark(
      bufnr,
      lnum - 1, 0,
      {
        line_hl_group  = BOOKMARK_LINE_HL,
        -- undo_restore = false,
        -- invalidate = true,
      }
    )

    -- bookmark alias
    local extmark_id2 = set_extmark(
      bufnr,
      lnum - 1, 0,
      {
        -- virt_text = { { alias, BOOKMARK_ALIAS_HL } },
        virt_lines = { {
          { bmid, BOOKMARK_ALIAS_HL },
          alias and { string.format(": %s", alias), BOOKMARK_ALIAS_HL } or nil
        } },
        virt_lines_above = true,
        virt_lines_leftcol = false,
        hl_mode = "combine",
        -- undo_restore = false,
        -- invalidate = true,
      }
    )

    state._[bmid] = {
      ex_ids = { extmark_id0, extmark_id1, extmark_id2, },
      alias = alias
    }
    state.modif = true
  end
  function this:set(bufnr, args)
    if not vim.__tbl.isarray(args) then
      set(bufnr, args.lnum, args.bmid, args.alias)
    else
      for _, arg in ipairs(args) do
        set(bufnr, arg.lnum, arg.bmid, arg.alias)
      end
    end

    emit_state_changed()
  end

  function this:change_alias(bufnr, lnum)
    local state = bm_states[bufnr]
    if not state then
      vim.__echo.warn(string.format("not found any bookmarks in lnum: %d", lnum))
    end

    if not lnum or lnum <= 0 then
      return
    end

    local alias_extid, alias_bmid
    for _, extmark in ipairs(get_extmarks(bufnr, lnum, { details = true })) do
      local details = extmark[4] or {}

      if details.virt_lines and details.virt_lines_above then
        alias_bmid = details.virt_lines[1][1][1]
        alias_extid = extmark[1]
        break
      end
    end

    if not alias_extid or not alias_bmid then
      vim.__echo.warn(string.format("not found any bookmarks in lnum: %d", lnum))
      return
    end

    vim.ui.input({ prompt = "change alias: ", }, function(alias)
      if vim.trim(alias or "") == "" then alias = nil end

      local new_extid = set_extmark(
        bufnr,
        lnum - 1, 0,
        {
          virt_lines = { {
            { alias_bmid, BOOKMARK_ALIAS_HL },
            alias and { string.format(": %s", alias), BOOKMARK_ALIAS_HL } or nil
          } },
          virt_lines_above = true,
          virt_lines_leftcol = false,
          hl_mode = "combine",
        }
      )

      del_extmark(bufnr, alias_extid)
      for bmid, bm in pairs(state._) do
        if bmid == alias_bmid then
          vim.__tbl.remove_iter(bm.ex_ids, function(t, i)
            return t[i] ~= alias_extid
          end)
          table.insert(bm.ex_ids, new_extid)

          bm.alias = alias
        end
      end
    end)
  end

  local function del_all(bufnr)
    local state = bm_states[bufnr]
    if not state then
      return
    end

    local extmarks = get_extmarks(bufnr)
    if not next(extmarks) then
      return
    end

    local echo_msg = {
      "Success delete bookmark:\n"
    }
    for bmid, bm in pairs(state._) do
      table.insert(echo_msg, string.format("  * bmid: `%s`, lnum: %s\n", bmid, concat_echo_str(get_extmark_lnum(bufnr, bm.ex_ids[1]), bm.alias)))
    end
    vim.__echo.info(table.concat(echo_msg, ""))

    state._ = {}
    state.modif = true

    for _, extmark in ipairs(extmarks) do
      del_extmark(bufnr, extmark[1])
    end
  end
  local function del_line(bufnr, lnum)
    local state = bm_states[bufnr]
    if not state then
      return
    end
    state.modif = true

    local function __del(extmark_id)
      del_extmark(bufnr, extmark_id)

      for bmid, bm in pairs(state._) do
        vim.__tbl.remove_iter(bm.ex_ids, function(t, i)
          return t[i] ~= extmark_id
        end)

        if not next(bm.ex_ids) then
          vim.__echo.info(string.format("Success delete bookmark [%s] from lnum %s", bmid, concat_echo_str(lnum, bm.alias)))
          state._[bmid] = nil
        end
      end
    end

    -- 删除当前行下的所有bookmark
    for _, extmark in ipairs(get_extmarks(bufnr, lnum)) do
      __del(extmark[1])
    end

    -- 如果是最后一行，则可能会有些invalid-bookmark残存
    local maxline = vim.__buf.maxline(bufnr)
    if lnum == maxline then
      local invalid_extmarks = get_extmarks(bufnr, nil, nil, function(t, i)
        return t[i][2] > maxline - 1
      end)
      for _, extmark in ipairs(invalid_extmarks)do
        __del(extmark[1])
      end
    end
  end
  function this:del(bufnr, lnum)
    if lnum then
      del_line(bufnr, lnum)
    else
      del_all(bufnr)
    end

    emit_state_changed()
  end

  local function jumpto_next(bufnr)
    local lnum, _ = vim.__cursor.get()

    local avalib_lnums_m = {}
    for _, extmark in ipairs(get_extmarks(bufnr, nil, nil, function(t, i)
      return t[i][2] > lnum - 1
    end)) do
      avalib_lnums_m[extmark[2]] = 1
    end

    local avalib_lnums = vim.__tbl.keys(avalib_lnums_m)
    if not avalib_lnums or #avalib_lnums == 0 then
      return false
    end
    table.sort(avalib_lnums)

    vim.__jumplst.add()
    vim.__cursor.set(avalib_lnums[1] + 1, 1)
  end
  local function jumpto_prev(bufnr)
    local lnum, _ = vim.__cursor.get()

    local function filter(t, i)
      return t[i][2] < lnum - 1
    end

    local avalib_lnums_m = {}
    for _, extmark in ipairs(get_extmarks(bufnr, nil, nil, filter)) do
      avalib_lnums_m[extmark[2]] = 1
    end

    local avalib_lnums = vim.__tbl.keys(avalib_lnums_m)
    if not avalib_lnums or #avalib_lnums == 0 then
      return false
    end
    table.sort(avalib_lnums)

    vim.__jumplst.add()
    vim.__cursor.set(avalib_lnums[#avalib_lnums] + 1, 1)
  end
  function this:jumpto(bufnr, direction)
    local ret
    if direction > 0 then
      ret = jumpto_next(bufnr)
    else
      ret = jumpto_prev(bufnr)
    end

    if ret == false then
      vim.__echo.warn("No more bookmarks")
    end
  end

  function this:goto(bufnr, bmid)
    local state = bm_states[bufnr]
    if not state then
      vim.__echo.warn(string.format("Bookmark: %s not found", bmid))
      return
    end

    local bm = state._[bmid]
    if not bm then
      vim.__echo.warn(string.format("Bookmark: %s not found", bmid))
      return
    end

    local extmark_id = bm.ex_ids[1]
    local lnum = get_extmark_lnum(bufnr, extmark_id)

    vim.__jumplst.add()
    vim.__cursor.set(lnum, 1)
  end

  function this:get_bmcount(bufnr)
    local count = 0

    local state = bm_states[bufnr]
    if not state then
      return count
    end

    for _, _ in pairs(state._) do
      count = count + 1
    end

    return count
  end

  function this:utils()
    return bm_states, bm_persists, get_extmark_lnum
  end

  function this:exists(bufnr, bmid)
    local state = bm_states[bufnr]
    if not state then
      return -1
    end

    if not bmid then
      return -1;
    end

    if not is_valid_bmid(bmid) then
      vim.__echo.warn(string.format("invalid bookmark: %s not support", bmid))
      return -1;
    end

    local bm = state._[bmid]
    if not bm then
      return -1;
    end

    return get_extmark_lnum(bufnr, bm.ex_ids[1])
  end

  function this:debug()
    vim.__logger.info("nsid:", BOOKMARK_NAMESPACE_ID)
    local bm_state_cpy = vim.deepcopy(bm_states)
    for bufnr, _ in pairs(bm_state_cpy) do
      bm_state_cpy[bufnr].extmarks = get_extmarks(bufnr)
    end
    vim.__logger.info("bm_states:", bm_state_cpy)
    vim.__logger.info("bm_persists:", bm_persists)
  end
end)

return Bookmark:new()
