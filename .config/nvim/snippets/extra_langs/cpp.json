{
  ".log": {
    "prefix": ".log",
    "body": "log << \"$TM_SELECTED_TEXT\";"
  },
  "bmk": {
    "prefix": "bmk",
    "body": "#include <benchmark/benchmark.h>\n\nvoid foo(benchmark::State& state) {\n\tfor (auto _: state) {\n\t\t$0\n\t}\n}\nBENCHMARK(foo);\n\nBENCHMARK_MAIN();"
  },
  "while": {
    "prefix": "while",
    "body": ["while ($1) {", "\t$0", "}"],
    "description": "`while` loop snippet"
  },
  "st": {
    "prefix": "st",
    "body": [
      "#include <iostream>",
      "",
      "int main (int argc, char *argv[]) {",
      "\t$0",
      "",
      "\treturn 0;",
      "}"
    ],
    "description": "Standard starter template for a tiny C++ program"
  },
  "forf": {
      "prefix": "forf",
      "body": [
          "for (${1}; ${2}; ${3}) {",
          "\t$0",
          "}"
      ],
      "description": "Code snippet for 'for' loop"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (${1:int} ${2:i} = ${3:0}; $2 < ${4:length}; ${5:$2++}) {",
      "\t$0",
      "}"
    ],
    "description": "Code snippet for 'for' loop"
  },
  "forr": {
    "prefix": "forr",
    "body": [
      "for (${1:int} ${2:i} = ${3:length} - 1; $2 >= ${4:0}; ${5:$2++}) {",
      "\t$0",
      "}"
    ],
    "description": "Code snippet for reverse 'for' loop"
  }
}
